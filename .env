# DealFlow360 — Environment Configuration (Development)

# PostgreSQL# Database Configuration
DATABASE_URL=sqlite:///./dealflow360.db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dealflow360
DB_USER=dealflow360
DB_PASSWORD=dealflow360

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# Security
SECRET_KEY=dev-secret-key-change-in-production
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
