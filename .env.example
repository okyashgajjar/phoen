# DealFlow360 — Environment Configuration
# Copy this file to .env and fill in your values

# PostgreSQL Database
DATABASE_URL=postgresql://dealflow360:dealflow360@localhost:5432/dealflow360
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dealflow360
DB_USER=dealflow360
DB_PASSWORD=dealflow360

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# Security
SECRET_KEY=CHANGE_ME_IN_PRODUCTION
JWT_SECRET=CHANGE_ME_IN_PRODUCTION
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
